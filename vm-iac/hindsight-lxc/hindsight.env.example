# /etc/hindsight/hindsight.env on the hindsight LXC — mode 600, root.
# The real file is generated ON the container (openssl rand) and never committed.

# Fact extraction (retain) and reflect go to Nous Portal, OpenAI-compatible.
# gpt-oss-20b: cheapest capable option (~$0.02 in / $0.09 out per 1M tokens on
# Nous) and the top retain model on Hindsight's own leaderboard. Recall itself
# never calls an LLM — embeddings and reranking run locally in the container.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://inference-api.nousresearch.com/v1
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
# HINDSIGHT_API_LLM_API_KEY is NOT here — it lives in /etc/hindsight/llm.env,
# written by the operator so the agent never handles it.

# API auth. Without this, anyone on the LAN can read and write the memory bank.
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=<openssl rand -hex 32>

# The bundled web UI talks to the API with the same bearer...
HINDSIGHT_CP_DATAPLANE_API_KEY=<same value as HINDSIGHT_API_TENANT_API_KEY>
# ...and has its own login key for humans. Different value.
HINDSIGHT_CP_ACCESS_KEY=<openssl rand -hex 32>
