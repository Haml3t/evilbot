# /etc/zfs-alert.env  (root:root, chmod 0600 — NEVER commit the real file)
# Credentials for notify-telegram.sh. Copy to /etc/zfs-alert.env on each host that
# sends alerts (evilbot + opsbot) and fill in real values.

# Telegram bot token (from the bot's own .env; the same bot is reused for alerts).
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>

# Destination chat id (personal DM = your numeric user id; group = -100... ).
# Discover via @userinfobot on Telegram.
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>
